# Backend Firebase Admin
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# HTTP
PORT=8080
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# First-run role bootstrap. Comma-separated Firebase UIDs; remove after use.
ROLE_BOOTSTRAP_UIDS=

# Android release signing (CI secrets should be used instead of local values)
ANDROID_KEYSTORE_FILE=release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=smartcontrol
ANDROID_KEY_PASSWORD=
