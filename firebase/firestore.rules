rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.role in ['OWNER', 'SUPER_ADMIN']; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(data) { return signedIn() && (data.ownerId == request.auth.uid || data.receiverId == request.auth.uid); }
    function immutable(field) { return request.resource.data[field] == resource.data[field]; }

    match /users/{uid} {
      allow read: if self(uid) || owner();
      allow create: if self(uid) && request.resource.data.uid == uid;
      allow update: if owner() || (self(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role);
      allow delete: if owner();
    }

    match /invites/{id} {
      allow create, update, delete: if owner();
      allow get: if owner() || (signedIn() && resource.data.status == 'PENDING' && resource.data.expiresAt > request.time);
      allow list: if owner();
    }

    match /linkedDevices/{id} {
      allow read: if owner() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.receiverId == request.auth.uid;
      allow update: if owner() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if owner() || (signedIn() && resource.data.receiverId == request.auth.uid);
    }

    match /consents/{id} {
      allow read: if participant(resource.data);
      allow create, update: if signedIn() && request.resource.data.receiverId == request.auth.uid;
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if owner() || (signedIn() && resource.data.actorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
