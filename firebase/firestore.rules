rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.role in ['OWNER', 'SUPER_ADMIN']; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isParticipant(data) {
      return signedIn() && (data.ownerId == request.auth.uid || data.receiverId == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isOwner();
      allow delete: if isSelf(uid) || isOwner();
    }

    match /invites/{inviteId} {
      allow create, update, delete: if isOwner();
      allow get: if isOwner() || (signedIn() && resource.data.status == 'PENDING' && resource.data.expiresAt > request.time);
      allow list: if isOwner();
    }

    match /linkedDevices/{deviceId} {
      allow read: if isOwner() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.receiverId == request.auth.uid;
      allow update: if isOwner() || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if isOwner() || (signedIn() && resource.data.receiverId == request.auth.uid);
    }

    match /consents/{consentId} {
      allow read: if isParticipant(resource.data);
      allow create, update: if signedIn() && request.resource.data.receiverId == request.auth.uid;
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isOwner() || (signedIn() && resource.data.actorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
